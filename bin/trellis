#!/usr/bin/env node
// trellis import <source> [<directory>]: a SHA-1 repository as a new SHA-256
// one, ready to push to a trellis:: remote. See client/import.mjs.
// trellis import-issues <github repo>: its issues and pull requests, in a
// repository pushed to Trellis. See client/github.mjs.
// trellis maintainers [add|remove <address>]: who besides the owner may push.
// trellis release <tag> [--title <t>] [--notes <text>] [<file>...]: a release
// with files, by a maintainer. See client/team.mjs.
// trellis export <git url>: branches and tags, as SHA-1, pushed there (a
// GitHub mirror, say). See client/export.mjs.
// trellis private: make a new repo private, before its first push.
// trellis readers [add|remove <address>]: who reads a private repo.
// trellis check <name> pending|pass|fail [...]: a CI result on a commit.
// trellis runners [add|remove <address>]: whose checks the repo counts.
// trellis ci [--once]: run .trellis/ci on each new branch tip, post results.
// trellis login: sign with Selfhold, the account the page uses, from now on.
// See client/signer.mjs.
// trellis mirror <sponsor>: every block of the repo kept by that sponsor too.
// See client/team.mjs.
import { execFileSync } from "node:child_process";
import { basename, resolve } from "node:path";
import { importRepository } from "../client/import.mjs";
import { importIssues } from "../client/github.mjs";
import { accept, forkRepo, transfer, makePrivate, maintainers, mirror, postCheck, publishOwnBox, readers, release, runCI, runnersOf } from "../client/team.mjs";
import { login } from "../client/signer.mjs";
import { exportTo } from "../client/export.mjs";

const usage = "usage: trellis import <github url or path> [<directory>]\n       trellis import-issues <github url>   (in a repository whose origin is trellis::)\n       trellis maintainers [add|remove <address>]   (likewise)\n       trellis mirror <sponsor url>   (likewise; in an up-to-date clone)\n       trellis login   (sign with Selfhold instead of a key file)\n       trellis release <tag> [--title <title>] [--notes <text>] [<file>...]   (in a repository whose origin is trellis::)\n       trellis export <git url>   (in a Trellis clone: its branches and tags as SHA-1, pushed there)\n       trellis private   (before a new repo's first push: only its members read it)\n       trellis readers [add|remove <address>]   (who reads a private repo)\n       trellis box   (publish your key file's box key, to be made a member of private repos)\n       trellis check <name> pending|pass|fail [--summary <s>] [--url <u>] [--commit <rev>]\n       trellis runners [add|remove <address>]\n       trellis ci [--once] [--every <seconds>] [--name <check>]   (run .trellis/ci on each new branch tip)\n       trellis transfer <address or @handle>[/<name>] | --cancel   (offer the repo to another account)\n       trellis accept   (in a clone of a repo offered to you: take it)\n       trellis fork   (in a clone of someone's repo: fork it; origin becomes yours, upstream theirs)";
const [command, source, directory] = process.argv.slice(2);
const configured = (key) => {
  try {
    return execFileSync("git", ["config", "--get", key], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim() || undefined;
  } catch {
    return undefined;
  }
};
const say = (line) => process.stderr.write(`trellis: ${line}\n`);
const fail = (error) => {
  process.stderr.write(`trellis: ${error?.message ?? error}\n`);
  process.exit(1);
};
if (command === "import" && source) {
  const dest = resolve(directory ?? basename(source.replace(/\/+$/, "")).replace(/\.git$/, ""));
  importRepository(source, dest).then(
    ({ head, branches, tags, commits, signed }) => {
      process.stdout.write(
        `imported ${commits} commits, ${branches.length} branches and ${tags.length} tags into ${dest} (SHA-256; HEAD ${head})\n` +
          (signed ? `${signed} signatures kept as text in git notes: they were made over the old ids\n` : "") +
          `next: git -C ${dest} remote add origin trellis::<your address>/<name>\n` +
          `      git -C ${dest} push origin --all && git -C ${dest} push origin --tags refs/notes/commits\n` +
          `then, in ${dest}: trellis import-issues ${source}\n`,
      );
    },
    fail,
  );
} else if (command === "import-issues" && source) {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  importIssues(source, { gitDir, say }).then(
    ({ items, comments, written }) => process.stdout.write(`${items} issues and pull requests and ${comments} comments from GitHub; ${written} records written\n`),
    fail,
  );
} else if (command === "maintainers") {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  maintainers(gitDir, source, directory, { say }).then((list) => process.stdout.write(list.map((a, i) => `${a}${i ? "" : "  (owner)"}\n`).join("")), fail);
} else if (command === "release" && source) {
  const rest = process.argv.slice(4);
  const options = { files: [] };
  for (let i = 0; i < rest.length; i++) {
    if (rest[i] === "--title") options.title = rest[++i];
    else if (rest[i] === "--notes") options.notes = rest[++i];
    else options.files.push(rest[i]);
  }
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  release(gitDir, source, { ...options, say }).then(({ tag, files }) => process.stdout.write(`released ${tag}${files.length ? ` with ${files.map((f) => f.name).join(", ")}` : ""}\n`), fail);
} else if (command === "export" && source) {
  try {
    const n = exportTo(process.cwd(), source, { say });
    process.stdout.write(`${n} branches and tags pushed as SHA-1\n`);
  } catch (error) {
    fail(error);
  }
} else if (command === "private") {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  makePrivate(gitDir, { say }).then(() => process.stdout.write("private: pushes are sealed, and only members read them\n"), fail);
} else if (command === "readers") {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  readers(gitDir, source, directory, { say }).then((list) => process.stdout.write(list.map((a) => `${a}\n`).join("")), fail);
} else if (command === "transfer") {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  const cancel = source === "--cancel";
  transfer(gitDir, cancel ? undefined : source, { cancel, say }).then((to) => process.stdout.write(to ? `offered to ${to}: it moves once they run trellis accept in a clone\n` : "the offer is taken back\n"), fail);
} else if (command === "fork") {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  forkRepo(gitDir, { say }).then((at) => process.stdout.write(`forked: origin is trellis::${at}, upstream the original\n`), fail);
} else if (command === "accept") {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  accept(gitDir, { say }).then((at) => process.stdout.write(`it's yours: trellis::${at} (origin set to it). Its old address leads here. To keep its blocks with your sponsor too: trellis mirror <sponsor url>\n`), fail);
} else if (command === "box") {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  publishOwnBox(gitDir, { say }).then((a) => process.stdout.write(`${a}'s box key is published: owners can make it a member of private repos\n`), fail);
} else if (command === "check" && source && directory) {
  const rest = process.argv.slice(5);
  const options = {};
  for (let i = 0; i < rest.length; i++) options[rest[i].replace(/^--/, "")] = rest[++i];
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  postCheck(gitDir, source, directory, { ...options, say }).then((id) => process.stdout.write(`${source}: ${directory} on ${id.slice(0, 10)}\n`), fail);
} else if (command === "runners") {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  runnersOf(gitDir, source, directory, { say }).then((list) => process.stdout.write(list.map((a) => `${a}\n`).join("")), fail);
} else if (command === "ci") {
  const rest = process.argv.slice(3);
  const options = { once: rest.includes("--once") };
  const at = (flag) => (rest.includes(flag) ? rest[rest.indexOf(flag) + 1] : undefined);
  if (at("--every")) options.every = Number(at("--every"));
  if (at("--name")) options.check = at("--name");
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  runCI(gitDir, { ...options, say }).then(() => {}, fail);
} else if (command === "login") {
  const urls = (process.env.TRELLIS_NODE ?? configured("trellis.node") ?? "").split(",").map((u) => u.trim()).filter(Boolean);
  login({ say, urls, sponsor: process.env.TRELLIS_SPONSOR ?? configured("trellis.sponsor")?.split(",")[0] }).then((address) => process.stdout.write(`signed in as ${address}: git push and trellis sign with Selfhold now (trellis.key = selfhold)\n`), fail);
} else if (command === "mirror" && source) {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  mirror(gitDir, source, { say }).then((n) => process.stdout.write(`${n} blocks kept by ${source}\n`), fail);
} else {
  process.stderr.write(`${usage}\n`);
  process.exit(2);
}
