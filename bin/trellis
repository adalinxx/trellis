#!/usr/bin/env node
// trellis import <source> [<directory>]: a SHA-1 repository as a new SHA-256
// one, ready to push to a trellis:: remote. See client/import.mjs.
// trellis import-issues <github repo>: its issues and pull requests, in a
// repository pushed to Trellis. See client/github.mjs.
// trellis maintainers [add|remove <address>]: who besides the owner may push.
// trellis login: sign with Selfhold, the account the page uses, from now on.
// See client/signer.mjs.
// trellis mirror <sponsor>: every block of the repo kept by that sponsor too.
// See client/team.mjs.
import { execFileSync } from "node:child_process";
import { basename, resolve } from "node:path";
import { importRepository } from "../client/import.mjs";
import { importIssues } from "../client/github.mjs";
import { maintainers, mirror } from "../client/team.mjs";
import { login } from "../client/signer.mjs";

const usage = "usage: trellis import <github url or path> [<directory>]\n       trellis import-issues <github url>   (in a repository whose origin is trellis::)\n       trellis maintainers [add|remove <address>]   (likewise)\n       trellis mirror <sponsor url>   (likewise; in an up-to-date clone)\n       trellis login   (sign with Selfhold instead of a key file)";
const [command, source, directory] = process.argv.slice(2);
const configured = (key) => {
  try {
    return execFileSync("git", ["config", "--get", key], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim() || undefined;
  } catch {
    return undefined;
  }
};
const say = (line) => process.stderr.write(`trellis: ${line}\n`);
const fail = (error) => {
  process.stderr.write(`trellis: ${error?.message ?? error}\n`);
  process.exit(1);
};
if (command === "import" && source) {
  const dest = resolve(directory ?? basename(source.replace(/\/+$/, "")).replace(/\.git$/, ""));
  importRepository(source, dest).then(
    ({ head, branches, tags, commits, signed }) => {
      process.stdout.write(
        `imported ${commits} commits, ${branches.length} branches and ${tags.length} tags into ${dest} (SHA-256; HEAD ${head})\n` +
          (signed ? `${signed} signatures kept as text in git notes: they were made over the old ids\n` : "") +
          `next: git -C ${dest} remote add origin trellis::<your address>/<name>\n` +
          `      git -C ${dest} push origin --all && git -C ${dest} push origin --tags refs/notes/commits\n` +
          `then, in ${dest}: trellis import-issues ${source}\n`,
      );
    },
    fail,
  );
} else if (command === "import-issues" && source) {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  importIssues(source, { gitDir, say }).then(
    ({ items, comments, written }) => process.stdout.write(`${items} issues and pull requests and ${comments} comments from GitHub; ${written} records written\n`),
    fail,
  );
} else if (command === "maintainers") {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  maintainers(gitDir, source, directory, { say }).then((list) => process.stdout.write(list.map((a, i) => `${a}${i ? "" : "  (owner)"}\n`).join("")), fail);
} else if (command === "login") {
  const urls = (process.env.TRELLIS_NODE ?? configured("trellis.node") ?? "").split(",").map((u) => u.trim()).filter(Boolean);
  login({ say, urls, sponsor: process.env.TRELLIS_SPONSOR ?? configured("trellis.sponsor")?.split(",")[0] }).then((address) => process.stdout.write(`signed in as ${address}: git push and trellis sign with Selfhold now (trellis.key = selfhold)\n`), fail);
} else if (command === "mirror" && source) {
  const gitDir = resolve(execFileSync("git", ["rev-parse", "--git-dir"], { encoding: "utf8" }).trim());
  mirror(gitDir, source, { say }).then((n) => process.stdout.write(`${n} blocks kept by ${source}\n`), fail);
} else {
  process.stderr.write(`${usage}\n`);
  process.exit(2);
}
